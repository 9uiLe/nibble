{
  "version": 1,
  "record": "docs/design/review.json",
  "inputs": [
    {
      "path": "app",
      "kind": "tree",
      "exclude_directories": [
        "*Tests",
        "TestSupport",
        "build",
        ".build",
        "DerivedData",
        "xcuserdata",
        "__pycache__"
      ],
      "exclude_files": [
        "*.md",
        ".DS_Store"
      ]
    },
    {
      "path": "runtime/rive",
      "kind": "tree",
      "exclude_files": [
        "*.md"
      ]
    },
    {
      "path": "docs/design",
      "kind": "tree",
      "exclude_directories": [
        "__pycache__"
      ],
      "exclude_files": [
        ".DS_Store"
      ],
      "references": true
    },
    {
      "path": "docs/product-specification.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/architecture/README.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/architecture/editing.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/architecture/presentation.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/architecture/keyboard.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/architecture/monetization.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "docs/design/evidence.md",
      "kind": "file",
      "references": true
    },
    {
      "path": "tools/ui-design",
      "kind": "tree",
      "exclude_directories": [
        "__pycache__"
      ],
      "exclude_files": [
        "*.pyc",
        ".DS_Store"
      ]
    },
    {
      "path": "flake.lock",
      "kind": "file"
    }
  ],
  "registries": [
    {
      "prefix": "C",
      "path": "docs/design/components.md",
      "format": "table",
      "columns": 4
    },
    {
      "prefix": "S",
      "path": "docs/design/screens.md",
      "format": "heading"
    },
    {
      "prefix": "F",
      "path": "docs/design/foundations.md",
      "format": "heading"
    },
    {
      "prefix": "R",
      "path": "docs/design/evidence.md",
      "format": "heading"
    },
    {
      "prefix": "G",
      "path": "docs/design/audit.md",
      "format": "heading"
    }
  ]
}
